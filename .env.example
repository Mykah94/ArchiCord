# Nur Beispielwerte – diese Datei enthält keine Zugangsdaten.
# Kopiere diese Datei nach .env und trage deine eigenen Daten lokal ein.
# .env niemals nach GitHub hochladen!

# Discord-Bot-Token aus dem Discord Developer Portal
DISCORD_TOKEN=DEIN_NEUER_DISCORD_BOT_TOKEN

# Archipelago-Verbindung
AP_URL=wss://archipelago.gg:61664
AP_SLOT=DEIN_SLOT_NAME
AP_PASSWORD=
# Spielname des Bot-Slots, muss zum Archipelago-Server passen.
AP_GAME=

# Discord-Kanäle (numerische Kanal-IDs)
ITEM_CHANNEL_ID=123456789012345678
HINT_CHANNEL_ID=123456789012345678
DEATHLINK_CHANNEL_ID=123456789012345678
STATUS_CHANNEL_ID=123456789012345678

# Optional: Live-Boards, Ziele und Feature-Ankündigungen trennen
HINT_BOARD_CHANNEL_ID=
DEATH_BOARD_CHANNEL_ID=
STATS_CHANNEL_ID=
GOAL_CHANNEL_ID=
FEATURES_CHANNEL_ID=
ARCHICORD_FEATURES_ANNOUNCE=true

# Optional: Slash-Befehle schneller auf einem Discord-Server synchronisieren
DISCORD_GUILD_ID=

# Bot / Datenhaltung
ARCHICORD_DATA_DIR=archicord_data
AP_POLL_INTERVAL=120
USE_ANSI_ITEM_NAMES=true
ARCHICORD_DEBUG=false

# Universal Tracker – bei nicht installiertem Tracker leer lassen
# Pfad zur echten Windows-Installation, Beispiel:
# ARCHICORD_UT_LAUNCHER=C:\ProgramData\Archipelago\ArchipelagoLauncherDebug.exe
ARCHICORD_UT_LAUNCHER=
ARCHICORD_UT_INTERVAL=120
ARCHICORD_CHECKS_FILE=tracker/exports/live_checks.json

# APWorld-Verwaltung
ARCHICORD_AP_INSTALL_DIR=C:\ProgramData\Archipelago
ARCHICORD_APWORLD_DIRS=
