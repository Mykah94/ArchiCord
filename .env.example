# Sample configuration only – no real credentials.
# Copy this file to .env and edit locally. NEVER commit your .env.

# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=YOUR_TOKEN

# Archipelago connection
AP_URL=wss://archipelago.gg:61664
AP_SLOT=YOUR_SLOT_NAME
AP_PASSWORD=
# Bot slot game name must match the Archipelago server
AP_GAME=

# Discord channels (numeric IDs)
ITEM_CHANNEL_ID=123456789012345678
HINT_CHANNEL_ID=123456789012345678
DEATHLINK_CHANNEL_ID=123456789012345678
STATUS_CHANNEL_ID=123456789012345678

# Optional: separate channels for boards, goals and feature announcements
HINT_BOARD_CHANNEL_ID=
DEATH_BOARD_CHANNEL_ID=
STATS_CHANNEL_ID=
GOAL_CHANNEL_ID=
FEATURES_CHANNEL_ID=
ARCHICORD_FEATURES_ANNOUNCE=true

# Official Archipelago software release notifications (optional)
# Set a Discord text-channel ID to announce future stable releases.
# The first check only stores the current version; no historical announcement.
ARCHIPELAGO_RELEASE_CHANNEL_ID=
# Poll interval in seconds (minimum 3600; default six hours)
ARCHIPELAGO_RELEASE_CHECK_INTERVAL=21600

# Optional: synchronize slash commands faster to one Discord server
DISCORD_GUILD_ID=

# Bot and local storage
ARCHICORD_DATA_DIR=archicord_data
AP_POLL_INTERVAL=120
USE_ANSI_ITEM_NAMES=true
ARCHICORD_DEBUG=false

# ArchiCord 3.0 local backups, managed by the running Web UI
# Hours: 24 (default), 1–168, 0 disables automatic backups
ARCHICORD_BACKUP_INTERVAL_HOURS=24

# Universal Tracker (optional: leave launcher empty if not installed)
# Example Windows installation:
# ARCHICORD_UT_LAUNCHER=C:\ProgramData\Archipelago\ArchipelagoLauncherDebug.exe
ARCHICORD_UT_LAUNCHER=
ARCHICORD_UT_INTERVAL=120
ARCHICORD_CHECKS_FILE=tracker/exports/live_checks.json

# APWorld discovery
ARCHICORD_AP_INSTALL_DIR=C:\ProgramData\Archipelago
ARCHICORD_APWORLD_DIRS=
